---
interface Props {items: string[][]; title?: string;}
const {items, title='Before you go'}=Astro.props;
---
<section id="faq" class="py-16"><div class="mx-auto max-w-4xl px-5"><p class="section-kicker">FAQ</p><h2 class="display mt-3 text-4xl font-bold">{title}</h2><div class="mt-8 divide-y divide-[#10231f]/20 border-y border-[#10231f]/20">{items.map(([q,a])=><details class="py-4"><summary class="cursor-pointer text-lg font-bold">{q}</summary><p class="mt-3 leading-7">{a}</p></details>)}</div></div></section>
