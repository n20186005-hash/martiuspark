---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreMore from '../components/ExploreMore.astro';
import GuideFAQ from '../components/GuideFAQ.astro';
import SourceNote from '../components/SourceNote.astro';
export const prerender = true;
const faqs = [["Where is Parc?", "Parc’s own website lists 800 Woodward Ave on Campus Martius Park. Consult its current menus, service hours and reservation terms."], ["Does Chalet 313 use Cadillac Lodge hours?", "No. They are separate venues; Chalet 313’s 2026/27 details are still pending on the operator page."], ["Are food outlets always open with the park?", "No. Restaurants, seasonal lounges, food vendors and events set their own schedules. Check the exact venue and date before travelling."]];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Campus Martius Park',item:'https://martiuspark.com/'},{'@type':'ListItem',position:2,name:"Dining at Campus Martius",item:'https://martiuspark.com/dining/'}]};
---
<BaseLayout title="Dining at Campus Martius | Parc & Seasonal Venues" description="Parc’s verified location and operator links, with Chalet 313 distinguished from Cadillac Lodge and seasonal food service kept separate from park hours." path="/dining/" current="dining" jsonLd={[faqSchema,breadcrumb]}>
<main>
<section class="bg-[#10231f] text-white relative overflow-hidden"><div class="mx-auto max-w-7xl px-5 py-16 sm:py-24"><nav aria-label="Breadcrumb" class="mb-5 text-sm"><a href="/" class="underline">Campus Martius Park</a> / Dining near the square</nav><p class="text-sm font-bold uppercase tracking-widest">Detroit · independent visitor guide</p><h1 class="display mt-5 max-w-4xl text-5xl font-bold leading-tight sm:text-7xl">Dining near the square</h1><p class="mt-6 max-w-3xl text-lg leading-8">Choose a specific venue, then verify its service period and availability. The park’s opening hours do not describe restaurant hours.</p></div></section><section class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Parc: confirmed operator location</h2><div class="mt-7 space-y-5 leading-8"><p><a class="underline" href="https://parcdetroit.com/hours-location/">Parc’s hours and location page</a> lists <b>800 Woodward Ave</b>, with lunch, dinner and weekend brunch periods. Use its current page for precise service and closing times, menus and reservation terms. Contact <a class="underline" href="tel:+13139227272">313-922-7272</a>. This confirms the published location and offerings, not an available table today.</p></div></div></section><section class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Keep seasonal venues distinct</h2><div class="mt-7 space-y-5 leading-8"><div class="grid gap-5 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Chalet 313 at Campus Martius</h3><p class="mt-3 leading-7">DDP’s page describes a heated lounge but says 2026/27 details are coming soon. Do not rely on the older 2025/26 schedule beneath that notice. <a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/chalet-313/">Check current Chalet 313 details</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Cadillac Lodge nearby</h3><p class="mt-3 leading-7">DDP lists the separate venue at 60 Campus Martius for 11 November 2026–3 January 2027. Its regular and special holiday hours belong to that venue alone. <a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/cadillac-lodge/">Cadillac Lodge’s current information</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Beach-side food</h3><p class="mt-3 leading-7">Summer food-and-drink announcements are seasonal. The operator’s older Cabana schedule is not proof of current October or winter service. Confirm the exact outlet with <a class="underline" href="https://downtowndetroit.org/experience-downtown/downtown-detroit-parks/campus-martius/">DDP</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Other food nearby</h3><p class="mt-3 leading-7">For a quick bite or sit-down meal, check the business’s own current address, menu and opening notice. Confirm the exact branch and service period; do not assume late-night availability or a particular walking distance.</p></article></div></div></div></section><GuideFAQ items={faqs} /><SourceNote /><ExploreMore exclude="/dining/" /></main></BaseLayout>
