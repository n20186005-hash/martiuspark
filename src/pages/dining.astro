---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreMore from '../components/ExploreMore.astro';
export const prerender = true;

const site = 'https://martiuspark.com';
const path = '/dining';
const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Campus Martius Park', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Dining', item: `${site}${path}` }
  ]
};

const faqs = [
  ['What restaurants are at Campus Martius Park?', 'Parc is on the park at 800 Woodward Ave, and Cadillac Lodge / Chalet 313 operates as a winter chalet beside The Rink. Within a block you\'ll also find Dime Store and Lafayette Coney Island.'],
  ['What is Chalet 313 at Campus Martius?', 'Chalet 313 (also known as Cadillac Lodge) is the park\'s seasonal alpine chalet serving food and drinks during the winter skating season, steps from The Rink.'],
  ['Is there a sit-down restaurant with park views?', 'Yes — Parc offers contemporary American dining with one of the best park-facing settings in downtown Detroit, directly on the square.'],
  ['Are there quick bites near the park?', 'Yes. Dime Store is a short walk for brunch and comfort plates, and Lafayette Coney Island is a classic Detroit stop for a coney dog.']
];
const faqJsonLd = { '@context':'https://schema.org','@type':'FAQPage', mainEntity: faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) };
---

<BaseLayout
  title="Dining at Campus Martius Park — Parc, Chalet 313 & Nearby Restaurants"
  description="Where to eat at Campus Martius Park in downtown Detroit: Parc on the square, the winter Chalet 313 / Cadillac Lodge, plus Dime Store and Lafayette Coney Island within a block."
  path={path}
  current="dining"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <main>
    <section class="bg-[#10231f] py-28 text-white"><div class="mx-auto max-w-7xl px-5">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60"><a href="/" class="underline">Campus Martius Park</a> <span class="px-1">→</span> Dining</nav>
      <h1 class="display mt-4 text-5xl font-bold sm:text-7xl">Dining nearby</h1>
      <p class="mt-6 max-w-2xl text-lg text-white/80">From a park-facing restaurant to a winter alpine chalet and classic Detroit counters — all within a block of the square.</p>
    </div></section>

    <section class="py-20"><div class="mx-auto max-w-7xl px-5">
      <p class="section-kicker">On the square</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Parc</h3><p class="mt-2 text-sm">Directly on the park at 800 Woodward Ave — polished contemporary American dining with one of the best park-facing settings in downtown Detroit.</p></div>
        <div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Chalet 313 / Cadillac Lodge</h3><p class="mt-2 text-sm">The seasonal winter chalet beside The Rink, serving food and drinks during skating season. <a href="/the-rink" class="font-bold text-[#a84532]">About The Rink →</a></p></div>
      </div>
    </div></section>

    <section class="bg-[#e7e0d3] py-20"><div class="mx-auto max-w-7xl px-5">
      <p class="section-kicker">A short walk</p>
      <h2 class="display mt-3 text-4xl font-bold">Within a block</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl bg-white/60 p-6"><b class="text-lg">Dime Store</b><p class="mt-2 text-sm">A short walk for brunch and comfort-food leaning breakfast and lunch plates.</p></div>
        <div class="rounded-3xl bg-white/60 p-6"><b class="text-lg">Lafayette Coney Island</b><p class="mt-2 text-sm">A classic Detroit stop nearby for a fast, no-frills coney dog.</p></div>
      </div>
    </div></section>

    <section id="faq" class="py-20"><div class="mx-auto max-w-4xl px-5"><p class="section-kicker">FAQ</p><h2 class="display mt-3 text-4xl font-bold">Dining questions</h2><div class="mt-8 divide-y divide-[#10231f]/15 border-y border-[#10231f]/15">{faqs.map(([q,a]) => <details class="group py-5"><summary class="cursor-pointer list-none text-lg font-bold">{q}<span class="float-right">＋</span></summary><p class="mt-3 max-w-3xl text-sm leading-6 text-[#10231f]/75">{a}</p></details>)}</div></div></section>

    <ExploreMore exclude={path} />
  </main>
</BaseLayout>
