---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreMore from '../components/ExploreMore.astro';
import GuideFAQ from '../components/GuideFAQ.astro';
import SourceNote from '../components/SourceNote.astro';
export const prerender = true;
const faqs = [["Is The Rink the whole park?", "No. It is a seasonal activity within the park, with separate hours and admission."], ["Are Chalet 313 and Cadillac Lodge the same?", "No. DDP publishes distinct pages and locations. Do not use one venue’s hours for the other."], ["Can I enter nearby landmarks?", "Not necessarily. Nearby buildings and attractions set their own visitor hours, security and admission rules. Confirm directly."]];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Campus Martius Park',item:'https://martiuspark.com/'},{'@type':'ListItem',position:2,name:"Campus Martius Park Directory",item:'https://martiuspark.com/directory/'}]};
---
<BaseLayout title="Campus Martius Park Directory | Facilities & Nearby Sights" description="Distinguish the park, seasonal rink and beach, Chalet 313, neighbouring Cadillac Lodge, dining and separate downtown landmarks." path="/directory/" current="directory" jsonLd={[faqSchema,breadcrumb]}>
<main>
<section class="bg-[#10231f] text-white relative overflow-hidden"><div class="mx-auto max-w-7xl px-5 py-16 sm:py-24"><nav aria-label="Breadcrumb" class="mb-5 text-sm"><a href="/" class="underline">Campus Martius Park</a> / Park directory</nav><p class="text-sm font-bold uppercase tracking-widest">Detroit · independent visitor guide</p><h1 class="display mt-5 max-w-4xl text-5xl font-bold leading-tight sm:text-7xl">Park directory</h1><p class="mt-6 max-w-3xl text-lg leading-8">Use this as a guide to places and seasonal features, not a list of everything open today.</p></div></section><section class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">At the park</h2><div class="mt-7 space-y-5 leading-8"><div class="grid gap-5 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Square and fountain</h3><p class="mt-3 leading-7">The operator describes a public square with seasonal installations and programming. Fountain operation and particular seating arrangements are not confirmed for today.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">The Rink</h3><p class="mt-3 leading-7">Upcoming 2026/27 skating begins 21 November. <a class="underline" href="/the-rink/">Rink hours and prices</a> are separate from the park.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Beach and summer activity</h3><p class="mt-3 leading-7">The beach and its food outlets are seasonal. A summer announcement does not establish operation in late October or winter. <a class="underline" href="https://downtowndetroit.org/experience-downtown/downtown-detroit-parks/campus-martius/">Check the park operator</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Chalet 313</h3><p class="mt-3 leading-7">DDP describes a two-storey heated lounge at Campus Martius. New 2026/27 details remain coming soon. <a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/chalet-313/">Current Chalet 313 information</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Dining</h3><p class="mt-3 leading-7">Parc’s own location page lists 800 Woodward Ave. <a class="underline" href="/dining/">See dining and reservation checks</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Holiday tree and events</h3><p class="mt-3 leading-7">The 2026 Tree Lighting is listed for 20 November. Confirm the dated <a class="underline" href="https://downtowndetroit.org/events/">DDP events calendar</a> for individual activities; there is no fixed daily performance schedule.</p></article></div></div></div></section><section class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Neighbouring places are separate</h2><div class="mt-7 space-y-5 leading-8"><div class="grid gap-5 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Cadillac Lodge</h3><p class="mt-3 leading-7">DDP lists 60 Campus Martius and an upcoming 11 November 2026–3 January 2027 season. It is distinct from Chalet 313. <a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/cadillac-lodge/">Check its own hours and holiday updates</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Hart Plaza and RiverWalk</h3><p class="mt-3 leading-7">These are separate riverfront destinations. Plan a route and check current access rather than assuming they are inside or one block from this park.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Guardian Building</h3><p class="mt-3 leading-7">A separate downtown building, not a guaranteed park amenity or freely accessible interior. Confirm visitor entry with the building.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Renaissance Center</h3><p class="mt-3 leading-7">A separate riverfront complex. QLINE does not take you inside it; consult current transit and building information before planning a connection.</p></article></div></div></div></section><GuideFAQ items={faqs} /><SourceNote /><ExploreMore exclude="/directory/" /></main></BaseLayout>
