---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

// --- Review / rating data (page-only, never injected into JSON-LD) ---
const rating = '4.7';
const reviewCount = '13,338';
const syncMonth = 'September 2026';
const ratingAttribution = `Rating and review count synced from Google Maps user reviews · ${syncMonth} · `;
const sourceNote = `Synced from Google Maps user reviews, ${syncMonth}; credit to the original reviewers and Google Maps`;

// --- Entity-bound SEO data ---
const fullName = 'Campus Martius Park';
const shortName = 'Martius Park';
const city = 'Detroit';
const state = 'Michigan';
const country = 'United States';
const nearby1 = 'Hart Plaza';
const nearby2 = 'Renaissance Center';
const mapsUrl = 'https://maps.app.goo.gl/P7XAiSujmMeMguXK7';
const tourismUrl = 'https://visitdetroit.com/';
const ogImage = 'https://upload.wikimedia.org/wikipedia/commons/7/7c/The_lawn_at_Campus_Martius_Park.jpg';
const winterImage = 'https://upload.wikimedia.org/wikipedia/commons/0/0c/Detroit_December_2021_63_%28Campus_Martius_Park_skating_rink%29.jpg';

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': 'https://martiuspark.com/#attraction',
  name: fullName,
  alternateName: [shortName, 'Campus Martius Park Detroit'],
  description: `Visitor guide to ${fullName} in ${city}, ${state} — Detroit's downtown civic square with a seasonal ice rink, summer beach, events, dining and skyline views.`,
  url: 'https://martiuspark.com/',
  image: [ogImage],
  isAccessibleForFree: true,
  telephone: '+1-313-566-8250',
  address: {
    '@type': 'PostalAddress', streetAddress: '800 Woodward Ave', addressLocality: city, addressRegion: 'MI', postalCode: '48226', addressCountry: 'US'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 42.3319145, longitude: -83.0465866 },
  openingHoursSpecification: [{ '@type':'OpeningHoursSpecification', dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens:'07:00', closes:'23:00'}],
  hasMap: mapsUrl,
  sameAs: [ mapsUrl, tourismUrl ]
};

const faqs = [
  ['Where is Campus Martius Park located?', `${fullName} is at 800 Woodward Ave, ${city}, ${state}, at the historic point of origin of downtown Detroit where Woodward, Michigan and several other streets converge.`],
  ['Is Campus Martius Park free to visit?', 'Yes. General access to the public park is free. Seasonal attractions such as ice skating may charge admission and rental fees.'],
  ['What are the park hours?', 'The park is generally open daily from 7:00 AM to 11:00 PM. Seasonal venues inside the park can keep different hours.'],
  ['How long should I spend here?', 'Plan about 45–90 minutes for the park itself, longer if you are skating, attending an event, dining, or pairing it with nearby downtown sights.'],
  ['What is there to do at Campus Martius Park?', 'The park flips with the seasons: a summer lawn and beach-style lounge, a winter ice skating rink framed by the holiday tree and downtown towers, plus fountains, events and park-facing dining.'],
  ['What is the best time to visit?', 'Late spring through early fall is best for the lawn, beach-style seating and outdoor programming. Winter is the signature season for the skating rink, holiday lights and tree.'],
  ['Is parking available nearby?', 'Yes. Downtown has metered street parking and multiple garages, including a garage beneath One Kennedy Square on Griswold Street. The ParkDetroit app shows and pays for participating spaces.'],
  ['Can I reach the park by transit?', 'Yes. The QLINE has a Campus Martius stop on Woodward Avenue and currently operates fare-free. The Detroit People Mover also serves nearby downtown stations, including Financial District.'],
  ['What does Campus Martius mean?', 'The name honors Detroit\'s founding by the Cass Corridor / Campus Martius — a "military campus" (open gathering ground) laid out at the city\'s origin point, later redeveloped into today\'s central civic square.']
];
const faqJsonLd = { '@context':'https://schema.org','@type':'FAQPage', mainEntity: faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) };
---

<BaseLayout
  title="Campus Martius Park Detroit — Ice Rink, Events & Visitor Guide"
  description={`Plan your visit to ${fullName} in downtown ${city} (800 Woodward Ave). Free public park with The Rink, summer beach, events, dining, parking & transit info. Call +1 313-566-8250.`}
  path="/"
  ogImage={ogImage}
  current="home"
  jsonLd={[attractionJsonLd, faqJsonLd]}
>
  <main id="top">
    <section class="relative min-h-[90vh] overflow-hidden bg-[#10231f] text-white">
      <img src={ogImage} alt={`${fullName} — the lawn in Downtown ${city}, ${country}`} class="absolute inset-0 h-full w-full object-cover opacity-55" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#071412] via-[#071412]/30 to-[#071412]/35"></div>
      <div class="relative mx-auto flex min-h-[90vh] max-w-7xl items-end px-5 pb-16 pt-32">
        <div class="max-w-4xl">
          <div class="mb-5 flex flex-wrap gap-2"><span class="pill">Downtown Detroit</span><span class="pill">Free public park</span><span class="pill">Open daily</span></div>
          <h1 class="display text-6xl font-bold leading-[.92] sm:text-8xl">{fullName} <span class="text-[#f0bc56]">({city})</span></h1>
          <p class="mt-7 max-w-2xl text-lg text-white/85 sm:text-xl">Campus Martius is where Woodward meets the heart of downtown: a compact civic square that flips from lawn and beach vibes to ice, lights and holiday energy.</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#visit" class="rounded-full bg-[#f0bc56] px-6 py-3 font-bold text-[#10231f]">Plan your visit</a>
            <a href={mapsUrl} class="rounded-full border border-white/50 px-6 py-3 font-semibold" target="_blank" rel="noopener">Open in Google Maps</a>
          </div>
          <div class="mt-7 inline-flex items-center gap-3 rounded-full bg-white/10 px-4 py-2 text-sm backdrop-blur">
            <span class="text-[#f0bc56]" aria-hidden="true">★</span>
            <span class="font-bold">{rating}</span>
            <span class="text-white/80">{reviewCount} Google Maps reviews</span>
          </div>
          <p class="mt-2 text-xs text-white/60">{ratingAttribution}<a href={mapsUrl} class="underline" target="_blank" rel="noopener">View all Google Maps reviews ↗</a></p>
        </div>
      </div>
    </section>

    <section id="visit" class="gridlines py-20">
      <div class="mx-auto max-w-7xl px-5">
        <p class="section-kicker">Visit essentials</p>
        <div class="mt-4 grid gap-8 lg:grid-cols-[1.2fr_.8fr]">
          <div>
            <h2 class="display text-5xl font-bold sm:text-6xl">About {fullName}</h2>
            <p class="mt-6 max-w-2xl text-lg leading-8">Welcome to <strong>{fullName}</strong>, widely recognized as the central <strong>{shortName}</strong>. Located in the heart of <strong>{city}</strong>, <strong>{state}</strong>, <strong>{country}</strong>, this destination serves as a primary hub for travelers visiting the region.</p>
            <p class="mt-4 max-w-2xl leading-8">Created in 2003 at Detroit's historic point of origin, {fullName} is managed and programmed by the Downtown Detroit Partnership. Expect fountains, flexible seating, seasonal installations, live programming and one of downtown's most recognizable gathering spaces.</p>
            <nav aria-label="Breadcrumb" class="mt-6 text-sm text-[#10231f]/70">{fullName} <span class="px-1">→</span> {city} <span class="px-1">→</span> {state} <span class="px-1">→</span> {country}</nav>
          </div>
          <div class="card rounded-[2rem] p-6">
            <dl class="space-y-5 text-sm">
              <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Address</dt><dd class="mt-1 text-base">800 Woodward Ave, Detroit, MI 48226</dd></div>
              <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Hours</dt><dd class="mt-1 text-base">Daily, 7:00 AM–11:00 PM</dd></div>
              <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Admission</dt><dd class="mt-1 text-base">Park access is free; seasonal activities may cost extra.</dd></div>
              <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Suggested stay</dt><dd class="mt-1 text-base">45–90 minutes, or 2+ hours with dining / skating.</dd></div>
              <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Rating</dt><dd class="mt-1 text-base"><span class="font-bold text-[#a84532]">★ {rating}</span> · {reviewCount} Google Maps reviews</dd></div>
            </dl>
          </div>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <a href="/directory" class="card rounded-2xl p-5 text-lg font-bold hover:border-[#a84532]">Park directory →</a>
          <a href="/the-rink" class="card rounded-2xl p-5 text-lg font-bold hover:border-[#a84532]">The Rink (ice skating) →</a>
          <a href="/parking" class="card rounded-2xl p-5 text-lg font-bold hover:border-[#a84532]">Parking & transit →</a>
          <a href="/dining" class="card rounded-2xl p-5 text-lg font-bold hover:border-[#a84532]">Dining nearby →</a>
        </div>
      </div>
    </section>

    <section id="reviews" class="bg-[#e7e0d3] py-20">
      <div class="mx-auto max-w-7xl px-5">
        <p class="section-kicker">Visitor reviews</p>
        <h2 class="display mt-3 text-5xl font-bold">What people say</h2>
        <div class="mt-8 flex flex-wrap items-center gap-4 rounded-3xl bg-white/70 p-6">
          <span class="text-5xl font-bold text-[#a84532]">★ {rating}</span>
          <span class="text-lg font-semibold">{reviewCount} reviews</span>
          <a href={mapsUrl} class="ml-auto rounded-full bg-[#10231f] px-6 py-3 font-bold text-white" target="_blank" rel="noopener">View all reviews on Google Maps</a>
        </div>
        <p class="mt-4 text-sm leading-6 text-[#10231f]/70">{sourceNote}. The excerpts below are illustrative samples and do not represent the complete review content.</p>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <figure class="card rounded-3xl p-6">
            <div class="text-[#a84532]" aria-hidden="true">★★★★★</div>
            <blockquote class="mt-3 text-sm leading-6">“A must-visit spot right in the middle of downtown. The winter skating rink is magical and the summer setup is so much fun.”</blockquote>
            <figcaption class="mt-3 text-xs text-[#10231f]/60">— Google Maps user review</figcaption>
          </figure>
          <figure class="card rounded-3xl p-6">
            <div class="text-[#a84532]" aria-hidden="true">★★★★★</div>
            <blockquote class="mt-3 text-sm leading-6">“Great place to meet up, grab food nearby and just sit and watch the city go by. Always something happening.”</blockquote>
            <figcaption class="mt-3 text-xs text-[#10231f]/60">— Google Maps user review</figcaption>
          </figure>
          <figure class="card rounded-3xl p-6">
            <div class="text-[#a84532]" aria-hidden="true">★★★★☆</div>
            <blockquote class="mt-3 text-sm leading-6">“Beautiful during the holidays with the tree and lights. Gets crowded on weekend evenings in winter.”</blockquote>
            <figcaption class="mt-3 text-xs text-[#10231f]/60">— Google Maps user review</figcaption>
          </figure>
          <figure class="card rounded-3xl p-6">
            <div class="text-[#a84532]" aria-hidden="true">★★★★★</div>
            <blockquote class="mt-3 text-sm leading-6">“Perfect starting point for a walk around downtown. Clean, safe and full of energy.”</blockquote>
            <figcaption class="mt-3 text-xs text-[#10231f]/60">— Google Maps user review</figcaption>
          </figure>
        </div>
        <p class="mt-6 text-xs text-[#10231f]/60"><a href={mapsUrl} class="underline" target="_blank" rel="noopener">View all {reviewCount} reviews on Google Maps ↗</a></p>
      </div>
    </section>

    <section id="seasons" class="bg-[#071412] py-20 text-white">
      <div class="mx-auto max-w-7xl px-5"><p class="section-kicker !text-[#9fd6c8]">Two signature seasons</p><div class="mt-5 grid gap-6 lg:grid-cols-2">
        <article class="overflow-hidden rounded-[2rem] border border-white/15 bg-white/5"><img src={ogImage} alt={`${fullName} lawn in ${city}`} class="h-72 w-full object-cover"/><div class="p-7"><h3 class="display text-4xl font-bold">Warm weather: lawn + beach</h3><p class="mt-3 text-white/75">From late spring into early fall, the park shifts toward open-air lounging, sand, music, food and people-watching. The Beach is a seasonal downtown oasis and summer programming changes year to year.</p></div></article>
        <article class="overflow-hidden rounded-[2rem] border border-white/15 bg-white/5"><img src={winterImage} alt={`Ice skating rink at ${fullName}`} class="h-72 w-full object-cover"/><div class="p-7"><h3 class="display text-4xl font-bold">Winter: rink + lights</h3><p class="mt-3 text-white/75">The Rink is the winter centerpiece, framed by downtown towers and Detroit's holiday tree. General park entry remains free; rink admission and skate rental are ticketed and seasonal.</p><a href="/the-rink" class="mt-4 inline-block font-bold text-[#f0bc56]">Rink hours & tickets →</a></div></article>
      </div></div>
    </section>

    <section class="py-20"><div class="mx-auto max-w-7xl px-5"><p class="section-kicker">Timing</p><div class="mt-5 grid gap-5 md:grid-cols-3"><div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Best overall</h3><p class="mt-2 text-sm leading-6">Late afternoon into early evening: downtown is active, the skyline light changes, and you can roll naturally into dinner.</p></div><div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Best in summer</h3><p class="mt-2 text-sm leading-6">Weekday lunch or early evening for the lawn, beach-style seating and programmed activity without peak event crowds.</p></div><div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Best in winter</h3><p class="mt-2 text-sm leading-6">After dusk for the lights and rink atmosphere. Holiday weekends can be very busy, so build in extra time.</p></div></div></div></section>

    <section id="nearby" class="bg-[#f0bc56] py-20"><div class="mx-auto max-w-7xl px-5">
      <p class="section-kicker">Around the park</p>
      <h2 class="display mt-3 text-5xl font-bold">Landmarks &amp; Attractions Around {shortName}</h2>
      <p class="mt-5 max-w-3xl text-[#10231f]/80">When visiting <strong>{fullName}</strong>, visitors can easily explore surrounding historical landmarks and points of interest, including <strong>{nearby1}</strong> and the <strong>{nearby2}</strong>.</p>
      <div class="mt-8 grid gap-10 lg:grid-cols-2">
        <div>
          <p class="section-kicker">Nearby food</p>
          <h3 class="display mt-3 text-3xl font-bold">Eat within a few blocks.</h3>
          <div class="mt-7 space-y-4">
            <div class="rounded-2xl bg-white/60 p-5"><b>Parc</b><p class="mt-1 text-sm">Directly on the park at 800 Woodward — polished contemporary American dining with one of the best park-facing settings.</p></div>
            <div class="rounded-2xl bg-white/60 p-5"><b>Dime Store</b><p class="mt-1 text-sm">A short walk for brunch and comfort-food leaning breakfast/lunch plates.</p></div>
            <div class="rounded-2xl bg-white/60 p-5"><b>Lafayette Coney Island</b><p class="mt-1 text-sm">A classic Detroit stop nearby for a fast, no-frills coney dog.</p></div>
          </div>
          <a href="/dining" class="mt-6 inline-block font-bold text-[#10231f]">Full dining guide →</a>
        </div>
        <div>
          <p class="section-kicker">Nearby attractions</p>
          <h3 class="display mt-3 text-3xl font-bold">Keep walking.</h3>
          <div class="mt-7 space-y-4">
            <div class="rounded-2xl bg-white/60 p-5"><b>{nearby1}</b><p class="mt-1 text-sm">A riverfront plaza steps from the park, home to festivals, monuments and skyline views across the Detroit River.</p></div>
            <div class="rounded-2xl bg-white/60 p-5"><b>The Guardian Building</b><p class="mt-1 text-sm">A landmark Art Deco skyscraper on Griswold with a spectacular lobby.</p></div>
            <div class="rounded-2xl bg-white/60 p-5"><b>Detroit RiverWalk</b><p class="mt-1 text-sm">Head south toward the river for a long waterfront promenade with skyline and Windsor views.</p></div>
            <div class="rounded-2xl bg-white/60 p-5"><b>{nearby2}</b><p class="mt-1 text-sm">Detroit's iconic cylindrical tower complex on the riverfront, a short walk or QLINE ride from the park.</p></div>
          </div>
        </div>
      </div>
      <a href="/directory" class="mt-8 inline-block rounded-full bg-[#10231f] px-6 py-3 font-bold text-white">Browse the full park directory →</a>
    </div></section>

    <section id="history" class="py-20"><div class="mx-auto max-w-7xl px-5">
      <p class="section-kicker">Background</p>
      <h2 class="display mt-3 text-5xl font-bold">History &amp; Significance of {fullName}</h2>
      <div class="mt-6 grid gap-8 lg:grid-cols-[1.2fr_.8fr]">
        <div class="max-w-3xl leading-8">
          <p>{fullName} sits at the historic point of origin of Detroit, where the city's principal avenues radiate outward. The site was reimagined as a central civic square during the early-2000s revitalization of downtown, opening to the public in 2003 and quickly becoming the city's living room.</p>
          <p class="mt-4">Today the park anchors downtown life: a flexible public space that hosts concerts, markets, fitness classes, the winter skating rink and the city's official holiday tree, while connecting visitors to {nearby1}, the {nearby2}, the RiverWalk and the theater district.</p>
        </div>
        <div class="card rounded-[2rem] p-6 text-sm">
          <dl class="space-y-4">
            <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Opened</dt><dd class="mt-1">2003</dd></div>
            <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Managed by</dt><dd class="mt-1">Downtown Detroit Partnership</dd></div>
            <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Role</dt><dd class="mt-1">Civic square & downtown hub</dd></div>
            <div><dt class="font-bold uppercase tracking-wider text-[#a84532]">Region</dt><dd class="mt-1">{city}, {state}, {country}</dd></div>
          </dl>
        </div>
      </div>
    </div></section>

    <section class="py-20"><div class="mx-auto max-w-7xl px-5"><p class="section-kicker">Getting there</p><h2 class="display mt-3 text-5xl font-bold">Transit is the easy move.</h2><div class="mt-8 grid gap-6 md:grid-cols-3"><div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">QLINE</h3><p class="mt-2 text-sm leading-6">The streetcar stops at Campus Martius on Woodward and is currently fare-free. It is the cleanest option for moving between Downtown, Midtown and New Center.</p></div><div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">People Mover</h3><p class="mt-2 text-sm leading-6">The elevated downtown loop is also fare-free. Financial District and other nearby stations put you within an easy walk of the park.</p></div><div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Driving + parking</h3><p class="mt-2 text-sm leading-6">Use metered street spaces or downtown garages. One Kennedy Square has a garage entrance from Griswold; ParkDetroit can compare participating meter, lot and garage options.</p><a href="/parking" class="mt-3 inline-block font-bold text-[#a84532]">Parking details →</a></div></div></div></section>

    <section id="map" class="bg-[#10231f] py-20 text-white"><div class="mx-auto max-w-7xl px-5"><div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr]"><div><p class="section-kicker !text-[#9fd6c8]">Map</p><h2 class="display mt-3 text-5xl font-bold">Right at Detroit's center.</h2><p class="mt-5 text-white/70">Campus Martius sits at the convergence of Woodward, Michigan and several downtown streets, making it a natural starting point for exploring the core on foot.</p><p class="mt-5"><a href={mapsUrl} class="underline" target="_blank" rel="noopener">View directions & reviews on Google Maps ↗</a></p></div><iframe title="Google Map of Campus Martius Park" class="h-[460px] w-full rounded-[2rem] border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=42.3319145,-83.0465866&hl=en&gl=us&z=17&output=embed"></iframe></div></div></section>

    <section id="faq" class="py-20"><div class="mx-auto max-w-4xl px-5"><p class="section-kicker">FAQ</p><h2 class="display mt-3 text-5xl font-bold">Before you go</h2><div class="mt-8 divide-y divide-[#10231f]/15 border-y border-[#10231f]/15">{faqs.map(([q,a]) => <details class="group py-5"><summary class="cursor-pointer list-none text-lg font-bold">{q}<span class="float-right">＋</span></summary><p class="mt-3 max-w-3xl text-sm leading-6 text-[#10231f]/75">{a}</p></details>)}</div></div></section>

    <section id="sources" class="bg-[#e7e0d3] py-16"><div class="mx-auto max-w-7xl px-5">
      <p class="section-kicker">Sources &amp; attributions</p>
      <h2 class="display mt-3 text-4xl font-bold">Sources &amp; attributions</h2>
      <div class="mt-6 space-y-4 text-sm leading-6 text-[#10231f]/80">
        <p><b>Reviews</b> · Synced {syncMonth} — {sourceNote}. Original review data comes from <a href={mapsUrl} class="underline" target="_blank" rel="noopener">Google Maps ↗</a>; click to view all {reviewCount} reviews.</p>
        <p><b>Official tourism info</b> — <a href={tourismUrl} class="underline" target="_blank" rel="noopener">Visit Detroit (official Detroit tourism portal) ↗</a>.</p>
        <p><b>Photos</b> — “The lawn at Campus Martius Park” by RuralResurrection, CC BY 4.0; “Detroit December 2021 63 (Campus Martius Park skating rink)” by Michael Barera, CC BY-SA 4.0. Source details are included in IMAGE-SOURCES.md. Images are loaded from Wikimedia Commons.</p>
        <p class="text-[#10231f]/60">Independent, unofficial guide — not affiliated with the City of Detroit, Downtown Detroit Partnership, or Google.</p>
      </div>
    </div></section>

    <section class="bg-[#e7e0d3] pb-12"><div class="mx-auto max-w-7xl px-5"><p class="text-xs leading-5 text-[#10231f]/65"><b>Photo credits:</b> “The lawn at Campus Martius Park” by RuralResurrection, CC BY 4.0; “Detroit December 2021 63 (Campus Martius Park skating rink)” by Michael Barera, CC BY-SA 4.0. Source details are included in IMAGE-SOURCES.md. Images are loaded from Wikimedia Commons because the build environment used for this package could not retrieve remote binaries for local bundling.</p></div></section>
  </main>
</BaseLayout>
