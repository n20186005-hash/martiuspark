---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideFAQ from '../components/GuideFAQ.astro';
import SourceNote from '../components/SourceNote.astro';
export const prerender = true;
const faqs = [["Where is Campus Martius Park?", "800 Woodward Ave, Detroit, MI 48226. The park and neighbouring businesses have separate entrances and operating arrangements."], ["What are the park hours?", "Visit Detroit lists daily 7 am–11 pm. The Google Maps snapshot checked 30 October 2026 instead displayed a 10 am opening. These listings differ; confirm access with Downtown Detroit Partnership and obey current on-site notices. Rink hours are separate."], ["Is the park free?", "General public-space access is distinct from paid activities. Skating admission, skate rental, dining and some events can carry charges; check the relevant operator before booking."], ["When does ice skating open?", "The operator announces the upcoming season from 21 November 2026. This does not mean the rink is already open on the 30 October check date."], ["How long should I plan?", "Allow time for your chosen activity, its opening arrangements and your return journey. Dining, queues, an event or skating can change the length of a visit; no uniform visit duration is established."], ["Can I arrive by transit?", "QLINE lists Campus Martius among its stops and currently advertises free rides. The People Mover has separate nearby stations and a zero-fare program. Check each operator for current service and accessible routes."], ["Where can I park or eat?", "Use the parking and dining guides for operator links. Garage space, street-parking legality, restaurant tables and seasonal openings are not guaranteed."]];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const attraction={'@context':'https://schema.org','@type':['TouristAttraction','Park'],'@id':'https://martiuspark.com/#park',name:'Campus Martius Park',url:'https://martiuspark.com/',address:{'@type':'PostalAddress',streetAddress:'800 Woodward Ave',addressLocality:'Detroit',addressRegion:'MI',postalCode:'48226',addressCountry:'US'},hasMap:'https://maps.app.goo.gl/P7XAiSujmMeMguXK7',sameAs:['https://downtowndetroit.org/experience-downtown/downtown-detroit-parks/campus-martius/','https://visitdetroit.com/directory/campus-martius-park-sports-parks/']};
---
<BaseLayout title="Campus Martius Park Detroit | Hours, Rink & Visitor Guide" description="Plan Campus Martius Park in downtown Detroit: park-hours sources, upcoming 2026/27 ice skating, dining, directory, parking and transit." path="/" current="home" jsonLd={[faqSchema,attraction]}>
<main>
<section class="bg-[#10231f] text-white relative overflow-hidden"><div class="mx-auto max-w-7xl px-5 py-16 sm:py-24"><p class="text-sm font-bold uppercase tracking-widest">Detroit · independent visitor guide</p><h1 class="display mt-5 max-w-4xl text-5xl font-bold leading-tight sm:text-7xl">Campus Martius Park</h1><p class="mt-6 max-w-3xl text-lg leading-8">A downtown square for a pause, a meal or seasonal activity. Start with the park, then check the separate schedule for the rink, an event or a restaurant.</p></div></section><section id="visit" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Plan your visit</h2><div class="mt-7 space-y-5 leading-8"><div class="flex flex-wrap gap-3"><a class="rounded-full bg-[#10231f] px-6 py-3 font-bold text-white" href="/the-rink/">Upcoming rink season</a><a class="rounded-full border px-6 py-3 font-bold" href="https://maps.app.goo.gl/P7XAiSujmMeMguXK7">Google Maps directions</a></div><div class="grid gap-5 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Address</h3><p class="mt-3 leading-7">800 Woodward Ave, Detroit, MI 48226.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Park hours: sources differ</h3><p class="mt-3 leading-7"><a class="underline" href="https://visitdetroit.com/directory/campus-martius-park-sports-parks/">Visit Detroit</a> lists daily 7 am–11 pm; the 30 October Maps snapshot displayed a 10 am opening. Confirm with <a class="underline" href="https://downtowndetroit.org/experience-downtown/downtown-detroit-parks/campus-martius/">DDP</a> before relying on either listing. No single schedule covers every facility.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Skating: upcoming, not open yet</h3><p class="mt-3 leading-7">The official 2026/27 season starts 21 November. <a class="underline" href="/the-rink/">See the separately published hours and prices</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Access and timing</h3><p class="mt-3 leading-7">Maps marks an accessible entrance, but we have not audited the complete route, toilets, seating or skating assistance. Ask the operator about your requirements. Plan around the confirmed schedule of your chosen activity rather than a uniform visit duration.</p></article></div></div></div></section><section id="reviews" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">A dated Maps snapshot</h2><div class="mt-7 space-y-5 leading-8"><p><b>4.7 / 5 · 13,373 reviews</b> — Google Maps listing checked 30 October 2026. This is a manual snapshot, not a live feed, an automatic sync or this guide’s own rating. <a class="underline" href="https://maps.app.goo.gl/P7XAiSujmMeMguXK7">Read current reviews on Google Maps</a>. We do not reproduce review text.</p></div></div></section><section id="seasons" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">One square, different seasons</h2><div class="mt-7 space-y-5 leading-8"><div class="grid gap-8 md:grid-cols-2"><figure><img src="/images/park-cover.svg" width="1440" height="900" loading="lazy" alt="Symbolic illustration of a green city square and skyline" class="w-full rounded-3xl"/><figcaption class="mt-3 text-sm">Original CC0 illustration; not a photograph or site plan.</figcaption><h3 class="mt-5 text-2xl font-bold">Lawn, beach and outdoor activity</h3><p class="mt-3">The park operator describes seasonal outdoor programming. A summer listing is not evidence that the beach, a food outlet or a fountain is operating today.</p></figure><figure><img src="/images/winter-cover.svg" width="1440" height="900" loading="lazy" alt="Symbolic illustration of a winter square with an ice oval" class="w-full rounded-3xl"/><figcaption class="mt-3 text-sm">Original CC0 illustration; not a current view of the rink.</figcaption><h3 class="mt-5 text-2xl font-bold">Rink and holiday activity</h3><p class="mt-3">Skating has its own tickets and season. <a class="underline" href="/the-rink/">Check the upcoming rink announcement</a>; do not assume park access means skating is available.</p></figure></div></div></div></section><section id="events" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Events and timing</h2><div class="mt-7 space-y-5 leading-8"><p>The DDP calendar lists the 2026 Detroit Tree Lighting on <b>Friday 20 November</b>, separate from the rink season’s start. <a class="underline" href="https://downtowndetroit.org/events/category/signature-ddp-event/day/2026-11-20/">View the official dated event listing</a>. Recheck details, any crowd-control arrangements and transport notices before travelling.</p><p>Choose your visit around a confirmed activity rather than a generic “best time.” Weather, events and temporary restrictions may change outdoor access. Daylight can make unfamiliar routes easier to assess; this guide does not guarantee night-time safety.</p></div></div></section><section id="nearby" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Directory, dining and nearby sights</h2><div class="mt-7 space-y-5 leading-8"><div class="grid gap-5 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">In the park</h3><p class="mt-3 leading-7"><a class="underline" href="/directory/">Browse the park directory</a> for the square, seasonal rink, beach and separately named venues.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Dining</h3><p class="mt-3 leading-7"><a class="underline" href="https://parcdetroit.com/hours-location/">Parc’s own page</a> confirms 800 Woodward Ave. Chalet 313 and Cadillac Lodge are different venues with their own seasonal announcements. <a class="underline" href="/dining/">See dining guidance</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Nearby landmarks</h3><p class="mt-3 leading-7">Hart Plaza, the Guardian Building, the RiverWalk and Renaissance Center are separate destinations, not park amenities. Confirm each destination’s access and route; no building entry or short walking time is promised.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Parking and transit</h3><p class="mt-3 leading-7"><a class="underline" href="/parking/">Plan parking and transit</a> with current operator links. QLINE and People Mover are distinct services, not a direct drop-off at every nearby attraction.</p></article></div></div></div></section><section id="history" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">History and management</h2><div class="mt-7 space-y-5 leading-8"><p>The modern park was dedicated on 19 November 2004, according to <a class="underline" href="https://downtowndetroit.org/news-insights/twenty-years-of-tree-lighting/">DDP’s historical account</a>. DDP manages and programs the park; this website is an independent guide.</p><p>The historical square and today’s seasonal activities are different subjects. The older dedication article does not establish current facility hours or admission arrangements.</p></div></div></section><section id="map" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Map and arrival</h2><div class="mt-7 space-y-5 leading-8"><p><a class="underline" href="https://maps.app.goo.gl/P7XAiSujmMeMguXK7">Open directions on Google Maps</a>. The embedded map loads from Google and is subject to <a class="underline" href="/privacy/">the privacy information</a>. Confirm the entrance for your specific destination.</p><iframe title="Google map locating Campus Martius Park in Detroit" class="h-[400px] w-full rounded-3xl border-0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" src="https://www.google.com/maps?q=Campus+Martius+Park+800+Woodward+Detroit&hl=en&z=17&output=embed"></iframe></div></div></section><GuideFAQ items={faqs} /><section id="sources" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Sources and illustration credits</h2><div class="mt-7 space-y-5 leading-8"><p>Checked 30 October 2026. <a class="underline" href="https://downtowndetroit.org/experience-downtown/downtown-detroit-parks/campus-martius/">DDP park information</a> supports the park’s identity, management and seasonal facilities; <a class="underline" href="https://visitdetroit.com/directory/campus-martius-park-sports-parks/">Visit Detroit’s exact park listing</a> supplies its published park hours. Maps is a separate third-party snapshot, not an operator schedule. The mismatch is retained above and omitted from hours schema.</p><p><a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/the-rink/">DDP rink information</a> supplies the upcoming skating season; <a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/chalet-313/">Chalet 313</a> still marks new-season details as coming soon; <a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/cadillac-lodge/">Cadillac Lodge</a> has a separate address and announcement. These are not interchangeable venues.</p><p>All displayed scenic images are original geometric illustrations, dedicated under <a class="underline" href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a>. <a class="underline" href="/ILLUSTRATION-CREDITS.txt">Download illustration credits</a>. They depict no actual person and are not photographs, reconstructions, maps or proof of current facilities.</p><p>Contact <a class="underline" href="tel:+13135668250">DDP general office: 313-566-8250</a> for park information; <a class="underline" href="tel:+13139639393">rink questions: 313-963-9393</a>. Neither number belongs to this independent guide.</p></div></div></section><SourceNote /></main></BaseLayout>