---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreMore from '../components/ExploreMore.astro';
export const prerender = true;

const site = 'https://martiuspark.com';
const path = '/parking';
const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Campus Martius Park', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Parking', item: `${site}${path}` }
  ]
};

const faqs = [
  ['Where do I park for Campus Martius Park?', 'The closest garage is beneath One Kennedy Square, with an entrance on Griswold Street, one block from the park. Several other downtown garages and metered street spaces are within a short walk.'],
  ['Is there free parking near Campus Martius?', 'Metered street parking is free on evenings, Sundays and city holidays once enforcement ends; garages are paid. The cheapest option is often transit — the QLINE and People Mover are currently fare-free.'],
  ['How much does downtown Detroit parking cost?', 'Metered street spaces and garages are priced by the operator and vary by day and event. The ParkDetroit app shows live availability and lets you pay for participating meters, lots and garages.'],
  ['Can I take transit instead of driving?', 'Yes, and it is the easiest move. The QLINE stops at Campus Martius on Woodward Avenue (fare-free), and the People Mover loop serves nearby downtown stations including Financial District.']
];
const faqJsonLd = { '@context':'https://schema.org','@type':'FAQPage', mainEntity: faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) };
---

<BaseLayout
  title="Parking & Transit for Campus Martius Park — Garages, Street Parking & QLINE"
  description="Where to park for Campus Martius Park in downtown Detroit: the One Kennedy Square / One Campus Martius garage, metered street parking, the ParkDetroit app, and fare-free QLINE & People Mover transit."
  path={path}
  current="parking"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <main>
    <section class="bg-[#f0bc56] py-28 text-[#10231f]"><div class="mx-auto max-w-7xl px-5">
      <nav aria-label="Breadcrumb" class="text-sm text-[#10231f]/70"><a href="/" class="underline">Campus Martius Park</a> <span class="px-1">→</span> Parking</nav>
      <h1 class="display mt-4 text-5xl font-bold sm:text-7xl">Parking &amp; transit</h1>
      <p class="mt-6 max-w-2xl text-lg">The square is in the middle of downtown — driving is easy, but the QLINE and People Mover drop you even closer.</p>
    </div></section>

    <section class="py-20"><div class="mx-auto max-w-7xl px-5">
      <p class="section-kicker">By car</p>
      <div class="mt-5 grid gap-6 md:grid-cols-3">
        <div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">One Kennedy Square garage</h3><p class="mt-2 text-sm">The nearest garage, entered from Griswold Street, about one block from the park.</p></div>
        <div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Metered street parking</h3><p class="mt-2 text-sm">On-street meters surround the core; free once evening/Sunday/holiday enforcement ends. Watch posted limits during events.</p></div>
        <div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">ParkDetroit app</h3><p class="mt-2 text-sm">Shows availability and pays for participating meters, lots and garages across downtown.</p></div>
      </div>
    </div></section>

    <section class="bg-[#071412] py-20 text-white"><div class="mx-auto max-w-7xl px-5">
      <p class="section-kicker !text-[#9fd6c8]">By transit</p>
      <h2 class="display mt-3 text-4xl font-bold">Skip the car</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl border border-white/15 bg-white/5 p-6"><h3 class="text-xl font-bold">QLINE</h3><p class="mt-2 text-sm">The streetcar stops at Campus Martius on Woodward Avenue and is currently fare-free — the cleanest way between Downtown, Midtown and New Center.</p></div>
        <div class="rounded-3xl border border-white/15 bg-white/5 p-6"><h3 class="text-xl font-bold">People Mover</h3><p class="mt-2 text-sm">The elevated downtown loop is also fare-free. Financial District and other nearby stations are an easy walk from the park.</p></div>
      </div>
    </div></section>

    <section id="faq" class="py-20"><div class="mx-auto max-w-4xl px-5"><p class="section-kicker">FAQ</p><h2 class="display mt-3 text-4xl font-bold">Parking questions</h2><div class="mt-8 divide-y divide-[#10231f]/15 border-y border-[#10231f]/15">{faqs.map(([q,a]) => <details class="group py-5"><summary class="cursor-pointer list-none text-lg font-bold">{q}<span class="float-right">＋</span></summary><p class="mt-3 max-w-3xl text-sm leading-6 text-[#10231f]/75">{a}</p></details>)}</div></div></section>

    <ExploreMore exclude={path} />
  </main>
</BaseLayout>
