---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreMore from '../components/ExploreMore.astro';
import GuideFAQ from '../components/GuideFAQ.astro';
import SourceNote from '../components/SourceNote.astro';
export const prerender = true;
const faqs = [["Is a parking space guaranteed?", "No. Rates, entry restrictions, event arrangements and capacity can change. Confirm the exact garage or legal street space before relying on it."], ["Is parking free on Sundays or at night?", "Do not assume that. Read current signs, meter instructions and city rules; a lack of a meter charge does not permit otherwise prohibited parking."], ["Are QLINE and the People Mover free?", "Both currently advertise free rides on the operator pages checked 30 October 2026. They have separate routes and operating arrangements; recheck before travelling."]];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Campus Martius Park',item:'https://martiuspark.com/'},{'@type':'ListItem',position:2,name:"Campus Martius Parking & Transit",item:'https://martiuspark.com/parking/'}]};
---
<BaseLayout title="Campus Martius Parking & Transit | Arrival Planning" description="Operator links for Campus Martius parking, QLINE and People Mover. Check legal spaces, current service, accessibility and event restrictions before travelling." path="/parking/" current="parking" jsonLd={[faqSchema,breadcrumb]}>
<main>
<section class="bg-[#f0bc56] text-[#10231f] relative overflow-hidden"><div class="mx-auto max-w-7xl px-5 py-16 sm:py-24"><nav aria-label="Breadcrumb" class="mb-5 text-sm"><a href="/" class="underline">Campus Martius Park</a> / Parking and transit</nav><p class="text-sm font-bold uppercase tracking-widest">Detroit · independent visitor guide</p><h1 class="display mt-5 max-w-4xl text-5xl font-bold leading-tight sm:text-7xl">Parking and transit</h1><p class="mt-6 max-w-3xl text-lg leading-8">Plan both the arrival and the return journey. Event restrictions, garage entrances and transit service can change.</p></div></section><section class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Driving and parking</h2><div class="mt-7 space-y-5 leading-8"><div class="grid gap-5 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Garage enquiry</h3><p class="mt-3 leading-7">Parc’s <a class="underline" href="https://parcdetroit.com/hours-location/">published arrival information</a> identifies a public garage beneath One Kennedy Square on Griswold Street. This is an operator’s location lead, not a checked vacancy, nearest-garage ranking, current price or entry guarantee.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Street parking</h3><p class="mt-3 leading-7">Follow the exact sign, meter, loading restriction and event notice where you stop. Do not assume evenings, Sundays or holidays permit free or unrestricted parking.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Payment tools</h3><p class="mt-3 leading-7">QLINE links to <a class="underline" href="https://www.parkdetroit.us/">ParkDetroit</a> among parking resources. Confirm that the chosen space participates and check the posted instructions; no live availability is promised.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Drop-off and access</h3><p class="mt-3 leading-7">Ask the venue or driver to confirm a legal stopping point and an accessible route. Maps marks an accessible park entrance; the full approach and venue-specific assistance have not been audited.</p></article></div></div></div></section><section class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Transit operators</h2><div class="mt-7 space-y-5 leading-8"><div class="grid gap-5 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">QLINE</h3><p class="mt-3 leading-7"><a class="underline" href="https://www.qlinedetroit.com/faq/">QLINE’s FAQ</a> currently says rides are free. Its <a class="underline" href="https://www.qlinedetroit.com/how-to-ride/">riding guide</a> lists Campus Martius. Check live service notices, direction and boarding location; do not assume it serves the riverfront complex directly.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Detroit People Mover</h3><p class="mt-3 leading-7"><a class="underline" href="https://www.thepeoplemover.com/stations-guide">The operator’s station guide</a> describes a current zero-fare program and lists Financial District at 133 W Larned. This is a separate elevated system; confirm operating hours, lift availability and your walking route.</p></article></div></div></div></section><GuideFAQ items={faqs} /><SourceNote /><ExploreMore exclude="/parking/" /></main></BaseLayout>
