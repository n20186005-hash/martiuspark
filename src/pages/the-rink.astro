---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreMore from '../components/ExploreMore.astro';
export const prerender = true;

const site = 'https://martiuspark.com';
const path = '/the-rink';
const ogImage = 'https://upload.wikimedia.org/wikipedia/commons/0/0c/Detroit_December_2021_63_%28Campus_Martius_Park_skating_rink%29.jpg';
const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Campus Martius Park', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'The Rink', item: `${site}${path}` }
  ]
};

const faqs = [
  ['When does the Campus Martius ice rink open?', 'The Rink typically opens for the winter season in mid-to-late November, around the time the park\'s holiday tree is lit, and runs through early March. Exact dates are announced each fall by the Downtown Detroit Partnership.'],
  ['What are the Campus Martius ice skating hours?', 'The Rink generally offers public skate sessions daily, with extended evening hours on weekends. Session times and holiday hours vary by week, so check the current schedule before you go.'],
  ['How much does it cost to skate at Campus Martius?', 'General park entry is free. Rink admission and skate rental are ticketed and priced per session; kids and residents often have discounted rates. Buy tickets in advance during peak holiday weeks.'],
  ['Can I rent ice skates at The Rink?', 'Yes. Skate rental is available on-site in standard sizes. You can also bring your own skates.'],
  ['Is the park free even when the rink is open?', 'Yes. The surrounding park — lawn, seating, fountain and holiday-tree viewing — remains free to enter. Only rink admission and skate rental are paid.']
];
const faqJsonLd = { '@context':'https://schema.org','@type':'FAQPage', mainEntity: faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) };
---

<BaseLayout
  title="The Rink at Campus Martius Park — Ice Skating Hours, Tickets & Rental"
  description="Everything about The Rink at Campus Martius Park Detroit: when it opens, public skate hours, ticket prices, skate rental and free park entry. Downtown Detroit's signature winter ice rink."
  path={path}
  ogImage={ogImage}
  current="rink"
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <main>
    <section class="relative overflow-hidden bg-[#10231f] text-white"><img src={ogImage} alt="The ice skating rink at Campus Martius Park, Detroit" class="absolute inset-0 h-full w-full object-cover opacity-45" /><div class="absolute inset-0 bg-gradient-to-t from-[#071412] via-[#071412]/40 to-[#071412]/30"></div><div class="relative mx-auto max-w-7xl px-5 py-28">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60"><a href="/" class="underline">Campus Martius Park</a> <span class="px-1">→</span> The Rink</nav>
      <h1 class="display mt-4 text-5xl font-bold sm:text-7xl">The Rink</h1>
      <p class="mt-6 max-w-2xl text-lg text-white/80">Downtown Detroit's signature winter ice skating rink — framed by the towers of Woodward and the city's official holiday tree.</p>
    </div></section>

    <section class="py-20"><div class="mx-auto max-w-7xl px-5">
      <p class="section-kicker">Plan your skate</p>
      <div class="mt-5 grid gap-6 md:grid-cols-3">
        <div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Season</h3><p class="mt-2 text-sm">Mid-to-late November through early March, aligned with the holiday-tree lighting. Dates announced each fall.</p></div>
        <div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Hours</h3><p class="mt-2 text-sm">Daily public-skate sessions, with longer weekend and evening hours. Holiday-week schedules vary.</p></div>
        <div class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Tickets & rental</h3><p class="mt-2 text-sm">Rink admission and skate rental are ticketed; the surrounding park stays free to enter.</p></div>
      </div>
      <p class="mt-8 max-w-3xl leading-8">The Rink sits in the center of Campus Martius Park at 800 Woodward Ave. Skating under the downtown skyline with the holiday tree lit behind you is one of Detroit's most photogenic winter experiences. Book ahead for weekend and holiday sessions, which sell out.</p>
    </div></section>

    <section id="faq" class="bg-[#e7e0d3] py-20"><div class="mx-auto max-w-4xl px-5"><p class="section-kicker">FAQ</p><h2 class="display mt-3 text-4xl font-bold">The Rink questions</h2><div class="mt-8 divide-y divide-[#10231f]/15 border-y border-[#10231f]/15">{faqs.map(([q,a]) => <details class="group py-5"><summary class="cursor-pointer list-none text-lg font-bold">{q}<span class="float-right">＋</span></summary><p class="mt-3 max-w-3xl text-sm leading-6 text-[#10231f]/75">{a}</p></details>)}</div></div></section>

    <ExploreMore exclude={path} />
  </main>
</BaseLayout>
