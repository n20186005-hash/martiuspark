---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreMore from '../components/ExploreMore.astro';
import GuideFAQ from '../components/GuideFAQ.astro';
import SourceNote from '../components/SourceNote.astro';
export const prerender = true;
const faqs = [["When does the rink open?", "DDP announces 21 November 2026 for the upcoming season. Check its current page before travelling."], ["Does the park schedule apply to skating?", "No. Use the rink schedule below; park, dining and event arrangements are separate."], ["Where should I ask about rental sizes or assistance?", "Ask the rink team at 313-963-9393 before booking. Availability, equipment sizes, assistance and session arrangements are not verified by this guide."]];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Campus Martius Park',item:'https://martiuspark.com/'},{'@type':'ListItem',position:2,name:"The Rink at Campus Martius",item:'https://martiuspark.com/the-rink/'}]};
---
<BaseLayout title="The Rink at Campus Martius | 2026/27 Hours & Prices" description="Upcoming Campus Martius ice skating: 21 November 2026 season start, two published hour ranges, admission and rental prices, and the official operator link." path="/the-rink/" current="rink" jsonLd={[faqSchema,breadcrumb]}>
<main>
<section class="bg-[#10231f] text-white relative overflow-hidden"><div class="mx-auto max-w-7xl px-5 py-16 sm:py-24"><nav aria-label="Breadcrumb" class="mb-5 text-sm"><a href="/" class="underline">Campus Martius Park</a> / The Rink</nav><p class="text-sm font-bold uppercase tracking-widest">Detroit · independent visitor guide</p><h1 class="display mt-5 max-w-4xl text-5xl font-bold leading-tight sm:text-7xl">The Rink</h1><p class="mt-6 max-w-3xl text-lg leading-8">The upcoming winter skating season has its own hours and charges. The announcement below was checked 30 October 2026; it is not a claim that skating is open now.</p></div></section><section id="hours" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">2026/27 announcement</h2><div class="mt-7 space-y-5 leading-8"><p>Season starts <b>21 November 2026</b>. The published schedule runs through <b>7 March 2027</b>. Source: <a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/the-rink/">DDP’s rink page</a>. All times are local Detroit time; recheck changes before booking.</p><div class="grid gap-6 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">21 November–3 January</h3><dl class="mt-4 space-y-3"><div><dt>Monday–Thursday and Sunday</dt><dd>11 am–10 pm</dd></div><div><dt>Friday–Saturday</dt><dd>11 am–midnight</dd></div><div><dt>Christmas Day</dt><dd>Noon–10 pm</dd></div><div><dt>New Year’s Eve</dt><dd>11 am–10 pm</dd></div></dl></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">4 January–7 March</h3><dl class="mt-4 space-y-3"><div><dt>Monday, Wednesday, Thursday</dt><dd>11 am–9 pm</dd></div><div><dt>Tuesday</dt><dd>11 am–6 pm</dd></div><div><dt>Friday–Saturday</dt><dd>11 am–11 pm</dd></div><div><dt>Sunday</dt><dd>Noon–8 pm</dd></div></dl></article></div></div></div></section><section id="prices" class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Published prices</h2><div class="mt-7 space-y-5 leading-8"><ul class="list-disc space-y-3 pl-6"><li>Adults, ages 13–58: <b>$14</b></li><li>Children 12 and under: <b>$10</b></li><li>Seniors 59+ with valid ID: <b>$10</b></li><li>Active military and first responders with valid ID: <b>$10</b></li><li>Skate rental: <b>$5</b></li></ul><p><a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/the-rink/">Follow the official page for ticket purchase and current terms</a>. Any checkout fees, discounts, availability and session conditions should be checked there; this guide does not sell tickets.</p></div></div></section><section class="py-16 "><div class="mx-auto max-w-7xl px-5"><h2 class="display text-4xl font-bold">Before booking</h2><div class="mt-7 space-y-5 leading-8"><div class="grid gap-5 md:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Separate venues</h3><p class="mt-3 leading-7">Skating is distinct from public-space access, restaurant admission and other seasonal venues. No park-hours listing guarantees a skating session.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Questions and access</h3><p class="mt-3 leading-7">Contact <a class="underline" href="tel:+13139639393">313-963-9393</a> for rink questions, group arrangements, equipment and access requirements.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Chalet 313</h3><p class="mt-3 leading-7">The operator lists a separate heated lounge; its 2026/27 details are still coming soon. Old 2025/26 hours are not a current schedule. <a class="underline" href="https://downtowndetroit.org/experience-downtown/things-to-do/chalet-313/">Check Chalet 313</a>.</p></article><article class="card rounded-3xl p-6"><h3 class="text-xl font-bold">Conditions</h3><p class="mt-3 leading-7">Recheck weather, operational updates and your return journey. No assumption of unlimited skating, equipment availability or access to surrounding buildings is made.</p></article></div></div></div></section><GuideFAQ items={faqs} /><SourceNote /><ExploreMore exclude="/the-rink/" /></main></BaseLayout>
